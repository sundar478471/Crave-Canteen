{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*", "./frontend/src/*"],
      "@shared/*": ["./shared/*"],
      "@frontend/*": ["./frontend/src/*"],
      "@backend/*": ["./backend/src/*"],
      "@ai-engine/*": ["./ai-engine/*"],
      "@ai-engine": ["./ai-engine/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "frontend/src/**/*",
    "backend/src/**/*",
    "shared/**/*",
    "ai-engine/**/*",
    "tests/**/*",
    "scripts/**/*",
    "vite-env.d.ts"
  ]
}