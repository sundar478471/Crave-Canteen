{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"],
      "@backend/*": ["./src/*"],
      "@ai-engine/*": ["../ai-engine/*"],
      "@ai-engine": ["../ai-engine/index.ts"]
    }
  },
  "include": ["src/**/*", "../ai-engine/**/*"]
}
